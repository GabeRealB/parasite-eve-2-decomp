+    # drop the candidate's addend so the two compare equal, otherwise a byte
+    # perfect jump-table match scores 2 * PENALTY_REGALLOC and never reaches 0.
+    # This is the same normalization tools/claude-decomp-env/dist.py applies.
+    repl = re.sub(RE_JTBL_SYMBOL, ".rodata", repl)
+    if repl == ".rodata":
+        imm = "0"
