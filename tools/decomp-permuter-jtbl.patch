+# Jump table symbols as splat emits them: jtbl_80013EB0, jtbl_8009E998_9F598.
+RE_JTBL_SYMBOL = re.compile(r"jtbl_[0-9A-Fa-f]+(?:_[0-9A-Fa-f]+)?")
+
+
+def parse_imm(imm: str) -> Optional[int]:
+    """Parse an objdump immediate, which may be bare hex with no 0x prefix.
+
+    A `j`/`jal` to a label inside the same function relocates against .text and
+    objdump prints the target as a bare hex address (`j 2d8 <fn+0x2d8>`), which
+    int(imm, 0) rejects. GCC emits those for long switch bodies, so refusing to
+    parse them crashes scoring on exactly the functions we care about here.
+    """
+    for base in (0, 16):
+        try:
+            return int(imm, base)
+        except ValueError:
+            pass
+    return None
+
+
 def process_mips_reloc(reloc_row: str, prev: str, repl: str, imm: str) -> str:
     if "R_MIPS_JALR" in reloc_row or "R_MIPS_NONE" in reloc_row:
         return repl
+    # The target side of a match comes from splat's asm, where a switch's jump
+    # table is a named symbol (jtbl_800141DC); the compiled side references its
