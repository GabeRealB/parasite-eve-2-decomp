#!/usr/bin/env bash
#
# Bootstrap a per-function matching scratch environment.
# Overlay-agnostic: resolves the .s file from any asm/<ver>/<overlay>/... tree
# (main, gameplay, title, and nested future overlays).
#
# Usage:
#   ./tools/claude [--bootstrap|--bootstrap-only] [--cli claude|grok] [--id ID] <function>
#
# Run from anywhere; the script cds to the repo root.

set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

BOOTSTRAP=true
BOOTSTRAP_ONLY=false
ID=""
ARG=""
CLI="claude"

usage() {
    echo "Usage: $0 [--bootstrap] [--bootstrap-only] [--cli claude|grok|glaude] [--id ID] <function_name_or_path_or_scratch_id>"
}

while [[ $# -gt 0 ]]; do
    case $1 in
        --bootstrap)
            BOOTSTRAP=true
            shift
            ;;
        --bootstrap-only)
            BOOTSTRAP_ONLY=true
            BOOTSTRAP=true
            shift
            ;;
        --no-bootstrap)
            BOOTSTRAP=false
            shift
            ;;
        --glaude)
            CLI="glaude"
            shift
            ;;
        --grok)
            CLI="grok"
            shift
            ;;
        --claude)
            CLI="claude"
            shift
            ;;
        --cli)
            if [[ $# -lt 2 ]]; then
                echo "Error: --cli requires a value"
                usage
                exit 1
            fi
            CLI="$2"
            shift 2
            ;;
        --id)
            if [[ $# -lt 2 ]]; then
                echo "Error: --id requires a value"
                usage
                exit 1
            fi
            ID="$2"
            shift 2
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            ARG="$1"
            shift
            ;;
    esac
done

CLAUDE_DIR="$ROOT/tools/claude-decomp-env"
CLAUDE_CONFIG="$ROOT/.claude"
M2C="$ROOT/tools/m2c/m2c.py"
OVERLAY_PY="$ROOT/tools/decomp_overlay.py"

create_unique_dir() {
    mkdir -p nonmatchings

    local base_dir="nonmatchings/$1"
    local dir="$base_dir"
    local counter=2

    while [[ -d "$dir" ]]; do
        dir="$base_dir-$counter"
        ((counter++))
    done

    mkdir -p "$dir"
    echo "$dir"
}

if [[ -z "$ARG" ]]; then
    usage
    exit 1
fi

resolve_func_json() {
    python3 "$OVERLAY_PY" find "$1" --json 2>/dev/null || true
}

FUNC_JSON="$(resolve_func_json "$ARG")"

# decomp.me scratch IDs are short alphanumerics. Prefer a real overlay function
# of the same name when one exists (future overlays may have short symbols).
USE_SCRATCH_SOURCE=false
if [[ -z "$FUNC_JSON" ]] && { [[ "$ARG" =~ ^[0-9]+$ ]] || [[ "$ARG" =~ ^[a-zA-Z0-9]+$ && ${#ARG} -ge 5 && ${#ARG} -le 10 ]]; }; then
    echo "Detected scratch ID: $ARG"

    if [[ -n "$ID" ]]; then
        echo "Error: --id cannot be used with a scratch ID"
        exit 1
    fi

    echo "Fetching from decomp.me API..."

    USER_AGENT=""
    if [[ -f .decomp_dev_secret ]]; then
        USER_AGENT=$(head -n 1 .decomp_dev_secret | tr -d '\n\r')
    fi

    if [[ -n "$USER_AGENT" ]]; then
        SCRATCH_DATA=$(curl -s -H "User-Agent: $USER_AGENT" "https://decomp.me/api/scratch/$ARG")
    else
        SCRATCH_DATA=$(curl -s "https://decomp.me/api/scratch/$ARG")
    fi

    if [[ $? -ne 0 || -z "$SCRATCH_DATA" ]]; then
        echo "Error: Failed to fetch scratch data from decomp.me"
        exit 1
    fi

    if echo "$SCRATCH_DATA" | grep -q '"error"'; then
        echo "Error: Scratch not found or API error"
        echo "$SCRATCH_DATA"
        exit 1
    fi

    DIFF_LABEL=$(echo "$SCRATCH_DATA" | python3 -c "import sys, json; data = json.load(sys.stdin); print(data.get('diff_label', ''))" 2>/dev/null)
    SOURCE_CODE=$(echo "$SCRATCH_DATA" | python3 -c "import sys, json; data = json.load(sys.stdin); print(data.get('source_code', ''))" 2>/dev/null)
    SCRATCH_SCORE=$(echo "$SCRATCH_DATA" | python3 -c "import sys, json; data = json.load(sys.stdin); score = data.get('score', 0); max_score = data.get('max_score', 0); pct = ((max_score - score) / max_score * 100) if max_score > 0 else 0; print(f'{pct:.2f}')" 2>/dev/null)

    if [[ -z "$DIFF_LABEL" || -z "$SOURCE_CODE" ]]; then
        echo "Error: Could not extract diff_label or source_code from API response"
        echo "$SCRATCH_DATA"
        exit 1
    fi

    FUNC_NAME="$DIFF_LABEL"
    USE_SCRATCH_SOURCE=true
    FUNC_JSON="$(resolve_func_json "$FUNC_NAME")"
else
    FUNC_NAME="$ARG"
fi

json_field() {
    local key=$1
    python3 -c 'import json,sys; data=json.loads(sys.argv[1] or "{}"); v=data.get(sys.argv[2]); print(v if v is not None else "")' "$FUNC_JSON" "$key"
}

if [[ "$FUNC_NAME" == *.s ]]; then
    ASM_PATH="$FUNC_NAME"
    FUNC_STEM="${FUNC_NAME##*/}"
    FUNC_STEM="${FUNC_STEM%.s}"
    if [[ -z "$FUNC_JSON" ]]; then
        FUNC_JSON="$(resolve_func_json "$FUNC_STEM")"
    fi
else
    FUNC_STEM="${FUNC_NAME%.s}"
    if [[ -z "$FUNC_JSON" ]]; then
        echo "Error: Could not find assembly file for function: $FUNC_STEM"
        echo "Searched every overlay under asm/**/{nonmatchings,matchings}"
        exit 1
    fi
    ASM_PATH="$(json_field asm_file)"
fi

if [[ ! -f "$ASM_PATH" ]]; then
    echo "Error: assembly file not found: $ASM_PATH"
    exit 1
fi

OVERLAY_NAME="$(json_field overlay)"
C_FILE="$(json_field c_file)"
echo "Function: $FUNC_STEM"
echo "Overlay: ${OVERLAY_NAME:-unknown}"
echo "ASM: $ASM_PATH"
if [[ -n "$C_FILE" ]]; then
    echo "C: $C_FILE"
fi

if [[ "$USE_SCRATCH_SOURCE" == true ]]; then
    DIR_NAME="${DIFF_LABEL%.s}"
else
    DIR_NAME="$FUNC_STEM"
fi

if [[ -n "$ID" ]]; then
    TARGET_DIR="nonmatchings/${DIR_NAME}-${ID}"
    if [[ -d "$TARGET_DIR" ]]; then
        echo "Directory already exists: $TARGET_DIR"
        echo "SCRATCH_DIR=$TARGET_DIR"
        if [[ "$BOOTSTRAP_ONLY" == true ]]; then
            echo "Bootstrap-only mode: directory ready at $TARGET_DIR"
        elif command -v "$CLI" &>/dev/null; then
            cd "$TARGET_DIR"
            if [[ "$CLI" == grok ]]; then
                grok --always-approve --effort "${GROK_MATCH_EFFORT:-xhigh}" \
                    --rules "$(sed "s/\\\$functionName/${FUNC_STEM}/g" "${CLAUDE_DIR}/MATCH_LOOP.md")" \
                    "Match ${FUNC_STEM}. Scratch env is already created (do not re-run tools/claude). Read BRIEF.md."
            else
                $CLI --dangerously-skip-permissions "decompile ${FUNC_STEM}. the appropriate claude environment has already been created (do not re-run tools/claude --bootstrap). use ultrathink"
            fi
        else
            echo "Please navigate to: $TARGET_DIR"
        fi
        exit 0
    fi
    mkdir -p "$TARGET_DIR"
    created_dir="$TARGET_DIR"
else
    created_dir=$(create_unique_dir "$DIR_NAME")
fi

write_blank_base() {
    local reason=$1
    {
        echo '#include "common.h"'
        echo ""
        echo "// $reason"
        echo ""
    } >"$created_dir/base.c"
}

# A give-up seed is only worth preferring over a fresh m2c run if it ever
# scored. An archive at 0.0 is a seed that never compiled - which is how it came
# to be archived - so handing it back reproduces the failure and, worse, hides
# the improved bootstrap behind it. 349 of 597 archived seeds were at 0.0.
giveup_seed_is_useful() {
    local meta="$ROOT/tools/giveups/$FUNC_STEM/meta.json"
    local score
    if [[ -f "$meta" ]]; then
        score=$(python3 -c '
import json, sys
try:
    print(float(json.load(open(sys.argv[1])).get("score") or 0))
except Exception:
    print(0)' "$meta" 2>/dev/null || echo 0)
        awk -v s="$score" 'BEGIN { exit !(s + 0 > 0) }' && return 0
        echo "Ignoring give-up seed for $FUNC_STEM: it never scored (${score}%)."
        return 1
    fi
    # No meta at all: trust it only if it does not carry m2c's unnamed-field
    # marker, which never compiles.
    if grep -qE '\->unk[0-9A-Fa-f]+' "$ROOT/tools/giveups/$FUNC_STEM/base.c" 2>/dev/null; then
        echo "Ignoring give-up seed for $FUNC_STEM: unnamed field access, will not compile."
        return 1
    fi
    return 0
}

GIVEUP_BASE="$ROOT/tools/giveups/$FUNC_STEM/base.c"
GIVEUP_META="$ROOT/tools/giveups/$FUNC_STEM/meta.json"

if [[ "$USE_SCRATCH_SOURCE" == true ]]; then
    {
        echo '#include "common.h"'
        echo ""
        echo "// Imported from decomp.me scratch $ARG (${SCRATCH_SCORE}% match)"
        echo ""
        echo "$SOURCE_CODE"
    } >"$created_dir/base.c"
    echo "Using source code from decomp.me scratch (${SCRATCH_SCORE}% match)"
elif [[ -f "$GIVEUP_BASE" ]] && giveup_seed_is_useful; then
    cp "$GIVEUP_BASE" "$created_dir/base.c"
    giveup_note="tools/giveups/$FUNC_STEM/base.c"
    if [[ -f "$GIVEUP_META" ]]; then
        giveup_note=$(python3 -c '
import json, sys
m = json.load(open(sys.argv[1], encoding="utf-8"))
score = m.get("score", "")
seed = m.get("seed_name", "base.c")
func = m.get("func", "?")
pinned = " pinned" if m.get("pinned") else ""
print("tools/giveups/%s/%s (%s%%%s)" % (func, seed, score, pinned))
' "$GIVEUP_META" 2>/dev/null || echo "$giveup_note")
    fi
    echo "Using give-up seed $giveup_note"
    echo "Do not restart from m2c. Compile this first, then dump/unpin/permute."
    # The score-best seed can be cornered on one penalty dimension. Name the
    # archived alternates so a retry can start from a different shape instead.
    if [[ -f "$GIVEUP_META" ]]; then
        python3 -c '
import json, sys
m = json.load(open(sys.argv[1], encoding="utf-8"))
alts = m.get("alternates") or []
if alts:
    func = m.get("func", "?")
    print("Alternate seeds (better on a penalty the best-scoring seed is stuck on):")
    for a in alts:
        pen = a.get("penalties") or {}
        mix = " ".join("%s=%s" % (k, pen[k]) for k in
                       ("stack","branch","regs","reorder","insert","delete") if k in pen)
        print("  tools/giveups/%s/%s (%s%%)%s"
              % (func, a.get("seed_name"), a.get("score"), "  " + mix if mix else ""))
' "$GIVEUP_META" 2>/dev/null || true
    fi
elif [[ "$BOOTSTRAP" == true ]]; then
    echo "Generating initial C code using m2c..."
    CONTEXT_ARG=()
    if [[ -n "$C_FILE" && -f "$C_FILE" ]]; then
        echo "Generating m2c context from $C_FILE..."
        if python3 tools/m2ctx.py "$C_FILE" 2>/dev/null && [[ -f ctx.c ]]; then
            CONTEXT_ARG=(--context ctx.c)
            echo "Context file generated successfully"
        else
            echo "Warning: Failed to generate context file, continuing without context"
        fi
    else
        echo "Note: host C file ${C_FILE:-unknown} not found, generating without context"
    fi

    # m2c cannot decompile a `jr $v0` switch unless the jump table is in its
    # input. splat leaves the table in the function's own .s only when the
    # rodata block is still unowned; otherwise it lives in the unit's
    # .rodata.s and m2c bails with "the corresponding jump table is not
    # provided", leaving a blank base.c that reads as a hard function.
    JTBL_ASM=()
    if grep -q 'jtbl_' "$ASM_PATH" 2>/dev/null; then
        # Search the overlay first: jtbl_ names are load addresses, so the same
        # name can exist in sibling overlays of a family.
        jtbl_scope="${ASM_PATH%%/nonmatchings/*}"
        if [[ "$jtbl_scope" == "$ASM_PATH" || ! -d "$jtbl_scope" ]]; then
            jtbl_scope="$ROOT/asm"
        fi
        while read -r jtbl; do
            [[ -n "$jtbl" ]] || continue
            # Defined right next to the function - m2c already sees it.
            if grep -qx "dlabel $jtbl" "$ASM_PATH"; then
                continue
            fi
            # One definition is enough, and splat emits some tables twice (the
            # unit .rodata.s and a per-symbol nonmatchings file); handing m2c
            # both is a duplicate definition.
            rodata=$(grep -rlx "dlabel $jtbl" "$jtbl_scope" --include='*.s' 2>/dev/null | head -1)
            if [[ -n "$rodata" && " ${JTBL_ASM[*]-} " != *" $rodata "* ]]; then
                JTBL_ASM+=("$rodata")
            fi
            # Overlay tables are jtbl_<overlay>_<hex>, not bare hex: a hex-only
            # pattern stops inside the name ("d" of dryfield, "ac" of actor) and
            # finds nothing, which is every family except main and gameplay.
        done < <(grep -oE 'jtbl_\w+' "$ASM_PATH" | sort -u)
    fi

    # Only narrow to the one function when extra inputs could widen the output.
    M2C_FUNC_ARG=()
    if [[ ${#JTBL_ASM[@]} -gt 0 ]]; then
        echo "Jump tables live outside the function; also feeding m2c: ${JTBL_ASM[*]}"
        M2C_FUNC_ARG=(-f "$FUNC_STEM")
    fi

    set +e
    M2C_OUTPUT=$(python3 "$M2C" --target mips-gcc-c "${M2C_FUNC_ARG[@]}" "${CONTEXT_ARG[@]}" "$ASM_PATH" "${JTBL_ASM[@]}" 2>&1)
    M2C_EXIT_CODE=$?
    set -e

    # A context m2c cannot parse aborts the whole run, so the function comes
    # back blank even though its own asm is fine. The GTE inline-asm macros in
    # some units do exactly this. Untyped output beats no output: retry bare.
    if [[ $M2C_EXIT_CODE -ne 0 && ${#CONTEXT_ARG[@]} -gt 0 ]] &&
        grep -q "parsing C context" <<<"$M2C_OUTPUT"; then
        echo "Warning: m2c could not parse the context from $C_FILE; retrying without it."
        echo "         Types will be '?' - the context, not the function, is the problem."
        set +e
        M2C_OUTPUT=$(python3 "$M2C" --target mips-gcc-c -f "$FUNC_STEM" "$ASM_PATH" "${JTBL_ASM[@]}" 2>&1)
        M2C_EXIT_CODE=$?
        set -e
    fi

    # `->unkNNN` is m2c's marker for a field it could not name, and it never
    # compiles: either the pointer is `void *` ("request for member in something
    # not a structure") or the struct is known but does not declare that offset
    # ("structure has no member named `unk4C0'"). Both are the same failure.
    # build.sh then fails before writing match_log.txt, so vacuum.sh records the
    # function as "1 attempt, 0.000" - a give-up for a function nobody ever
    # compiled. 523 functions were parked that way in a single day, 85 of which
    # a seed matches outright. --valid-syntax emits M2C_FIELD() instead, which
    # compiles and can be scored; it is uglier, and being able to score an ugly
    # seed beats not being able to build a pretty one.
    if [[ $M2C_EXIT_CODE -eq 0 ]] && grep -qE '\->unk[0-9A-Fa-f]+' <<<"$M2C_OUTPUT"; then
        echo "Seed dereferences an untyped pointer; retrying with --valid-syntax."
        set +e
        VS_OUTPUT=$(python3 "$M2C" --target mips-gcc-c --valid-syntax \
            "${M2C_FUNC_ARG[@]}" "${CONTEXT_ARG[@]}" "$ASM_PATH" "${JTBL_ASM[@]}" 2>&1)
        VS_CODE=$?
        set -e
        if [[ $VS_CODE -eq 0 && -n "$VS_OUTPUT" ]]; then
            M2C_OUTPUT="$VS_OUTPUT"
            M2C_VALID_SYNTAX=true
        fi
    fi

    if [[ $M2C_EXIT_CODE -ne 0 ]]; then
        echo "Warning: m2c failed to generate C code. Creating blank base.c file."
        echo "$M2C_OUTPUT"
        write_blank_base "file is blank because m2c failed to decompile function"
    else
        {
            echo '#include "common.h"'
            # m2c types the seed against a context built from the host C file,
            # then the seed lands in a base.c that includes only common.h - so
            # it names types nothing declares and will not compile
            # ("`Actor120300Work' undeclared"). build.sh fails before writing
            # match_log.txt and vacuum.sh files the function as "1 attempt,
            # 0.000": a give-up for a function nobody compiled. Carry the host's
            # own includes across so the seed can see what it was typed against.
            if [[ -n "$C_FILE" && -f "$C_FILE" ]]; then
                grep -E '^#include "' "$C_FILE" | grep -v '"common.h"' || true
            fi
            # m2c also learns globals from the context, and with --globals used
            # it does not re-declare what the context already had - but the
            # context is the host .c, which often declares them file-locally
            # rather than in a header. The seed then names a symbol nothing
            # declares ("`D_actor_121300_8013D418' undeclared"). Carry across
            # exactly the host declarations the seed actually references.
            if [[ -n "$C_FILE" && -f "$C_FILE" ]]; then
                M2C_BODY="$M2C_OUTPUT" python3 - "$C_FILE" <<'PYEOF' 2>/dev/null || true
import os, re, sys
host = open(sys.argv[1], encoding="utf-8", errors="replace").read()
body = os.environ.get("M2C_BODY", "")
names = set(re.findall(r"\b[A-Za-z_]\w*\b", body))
for line in host.splitlines():
    m = re.match(r"^\s*extern\s+[^;=]*?\b(\w+)\s*(?:\[[^\]]*\])?\s*;\s*$", line)
    if m and m.group(1) in names:
        print(line.strip())
PYEOF
            fi
            [[ "${M2C_VALID_SYNTAX:-false}" == true ]] && echo '#include "m2c_macros.h"'
            echo ""
            echo "// This is a decompilation attempt by the m2c tool."
            echo "// Function/type definitions might be missing or incomplete."
            echo "// The code will likely not compile without further modification."
            echo ""
            echo "$M2C_OUTPUT"
        } >"$created_dir/base.c"
        echo "Generated initial C code from assembly using m2c"
    fi
else
    write_blank_base "blank base.c (--no-bootstrap)"
fi

cat "${CLAUDE_DIR}/prelude.inc" "${CLAUDE_DIR}/../../include/macro.inc" "$ASM_PATH" >"$created_dir/target.s"
mips-linux-gnu-as -EL -march=r3000 -mtune=r3000 -Iinclude -o "$created_dir/target.o" "$created_dir/target.s"

ln -sfn "${CLAUDE_DIR}/"* "$created_dir/"
rm -f "$created_dir/CLAUDE.md" "$created_dir/AGENTS.md"
{
    sed "s/\\\$functionName/${FUNC_STEM}/g" "${CLAUDE_DIR}/CLAUDE.md"
    echo
    sed "s/\\\$functionName/${FUNC_STEM}/g" "${CLAUDE_DIR}/MATCH_LOOP.md"
} >"$created_dir/CLAUDE.md"
# Grok loads AGENTS.md / CLAUDE.md from cwd; vacuum often starts at repo root,
# but a cd into the scratch dir still picks this up.
cp "$created_dir/CLAUDE.md" "$created_dir/AGENTS.md"
ln -sfn "${CLAUDE_CONFIG}" "$created_dir/"
ln -sfn "$ROOT/DECOMPILATION_LEARNINGS.md" "$created_dir/"
ln -sfn "$ROOT/CODEGEN_MODEL.md" "$created_dir/"

# Carrying the host includes across makes the seed's types resolve, but it also
# puts m2c's guessed prototypes next to the real ones. Let the compiler say
# which pairs conflict and drop m2c's side. This has to run after build.sh is
# linked into the scratch dir, not right after base.c is written.
if [[ "$BOOTSTRAP" == true ]]; then
    python3 "$ROOT/tools/seed_repair.py" "$created_dir" || true
fi

python3 "$OVERLAY_PY" pack "$FUNC_STEM" >"$created_dir/BRIEF.md"
echo "Wrote $created_dir/BRIEF.md"

echo "SCRATCH_DIR=$created_dir"

if [[ "$BOOTSTRAP_ONLY" == true ]]; then
    echo "Bootstrap-only mode: environment ready at $created_dir"
elif command -v "$CLI" &>/dev/null; then
    cd "$created_dir"
    if [[ "$CLI" == grok ]]; then
        grok --always-approve --effort "${GROK_MATCH_EFFORT:-xhigh}" \
            --rules "$(sed "s/\\\$functionName/${FUNC_STEM}/g" "${CLAUDE_DIR}/MATCH_LOOP.md")" \
            "Match ${FUNC_STEM}. Scratch env is already created (do not re-run tools/claude). Read BRIEF.md."
    else
        $CLI --dangerously-skip-permissions "decompile ${FUNC_STEM}. the appropriate claude environment has already been created (do not re-run tools/claude --bootstrap). use ultrathink"
    fi
else
    echo "Success! Please navigate to the created directory and start your decompilation work:"
    echo ""
    echo "  cd $created_dir"
    echo ""
fi
